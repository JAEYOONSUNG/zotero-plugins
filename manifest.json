{
  "manifest_version": 2,
  "name": "ZotPoP",
  "version": "0.34.0",
  "description": "Publish or Perish-style literature search inside Zotero: query OpenAlex, Crossref, Semantic Scholar, PubMed, arXiv or Google Scholar, see citation metrics, and add papers (with PDFs) straight to your library.",
  "author": "Jae Yoon Sung",
  "homepage_url": "https://github.com/sungjaeyoon92/zotero-zotpop",
  "icons": {
    "16": "content/icons/zotpop-16.png",
    "32": "content/icons/zotpop-32.png",
    "48": "content/icons/zotpop-48.png",
    "96": "content/icons/zotpop-96.png",
    "128": "content/icons/zotpop-128.png"
  },
  "applications": {
    "zotero": {
      "id": "zotpop@sungjaeyoon.dev",
      "update_url": "https://raw.githubusercontent.com/sungjaeyoon92/zotero-zotpop/main/update.json",
      "strict_min_version": "6.999",
      "strict_max_version": "10.*"
    }
  }
}
